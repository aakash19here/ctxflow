{
  "name": "ctxflow",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "drizzle-orm": "^0.44.6",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/node": "^24.7.2",
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "typescript": "^5.8.3",
      "zod": "^4.1.12"
    }
  },
  "scripts": {
    "dev": "dotenv -- turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:dashboard": "turbo -F dashboard dev",
    "dev:widget": "turbo -F widget dev",
    "dev:server": "turbo -F server dev",
    "shadcn:add": "turbo -F dashboard shadcn:add --",
    "db:push": "dotenv -- turbo run db:push",
    "db:studio": "dotenv -- turbo run db:studio",
    "db:generate": "turbo run db:generate",
    "db:migrate": "dotenv -- turbo run db:migrate"
  },
  "dependencies": {
    "@ai-sdk/provider": "^2.0.0",
    "@repo/typescript-config": "workspace:*",
    "react-scan": "^0.4.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.5.8",
    "@types/bun": "latest"
  },
  "packageManager": "bun@1.3.0",
  "type": "module",
  "module": "index.ts",
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
